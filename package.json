{
  "name": "termaid",
  "version": "1.5.1",
  "description": "Modern AI-powered terminal with Ollama integration",
  "main": "dist/electron/main.js",
  "homepage": "https://github.com/openhoat/termaid",
  "scripts": {
    "build": "wireit",
    "build:electron": "wireit",
    "build:vite": "wireit",
    "bump-version": "node scripts/bump-version.js",
    "changelog": "node scripts/generate-changelog.js",
    "clean": "rimraf -g -v dist release **/tsconfig.tsbuildinfo",
    "commit:lint": "commitlint --edit",
    "ci:llm": "npx tsx --tsconfig electron/tsconfig.json scripts/test-llm.ts batch tests/llm-regression.json --json --exit-code",
    "debug:prompt": "npx tsx --tsconfig electron/tsconfig.json scripts/debug-prompt.ts",
    "dev": "wireit",
    "test:llm": "npx tsx --tsconfig electron/tsconfig.json scripts/test-llm.ts",
    "dev:electron": "wireit",
    "dev:vite": "wireit",
    "dist": "wireit",
    "dist:linux": "wireit",
    "dist:mac": "wireit",
    "dist:win": "wireit",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "generate-icons": "node scripts/generate-icons.js",
    "lint": "eslint src --ext .ts,.tsx",
    "prepare": "husky",
    "qa": "wireit",
    "qa:fix": "biome check --write .",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headless": "wireit",
    "test:e2e:headless:ci": "HEADLESS=true playwright test",
    "test:e2e:ui": "UI_MODE=true playwright test --ui",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "validate": "wireit"
  },
  "keywords": [],
  "author": "Olivier Penhoat <openhoat@gmail.com> (http://headwood.net/)",
  "license": "ISC",
  "volta": {
    "node": "22.22.0",
    "npm": "10.9.4"
  },
  "dependencies": {
    "@langchain/anthropic": "1.3.22",
    "@langchain/core": "1.1.31",
    "@langchain/ollama": "1.2.6",
    "@langchain/openai": "1.2.12",
    "axios": "1.13.6",
    "electron-store": "11.0.2",
    "i18next": "25.8.14",
    "i18next-browser-languagedetector": "8.2.1",
    "node-pty": "1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "16.5.6",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "electron": "40.8.0",
    "electron-builder": "26.8.1",
    "electron-icon-builder": "2.0.1",
    "fs-extra": "11.3.4",
    "happy-dom": "20.8.3",
    "husky": "9.1.7",
    "rimraf": "6.1.3",
    "sharp": "0.34.5",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "4.0.18",
    "wireit": "^0.14.5"
  },
  "wireit": {
    "build:vite": {
      "command": "vite build",
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "shared/**/*.ts",
        "vite.config.ts",
        "index.html"
      ],
      "output": [
        "dist/index.html",
        "dist/assets/**/*",
        "dist/logo.svg"
      ]
    },
    "build:electron": {
      "command": "tsc -p electron/tsconfig.json && tsc-alias -p electron/tsconfig.json && node scripts/fix-imports.js && node -e \"const fs=require('fs');const path=require('path');const src=path.join('electron','prompts');const dest=path.join('dist','electron','prompts');if(fs.existsSync(src)){fs.mkdirSync(dest,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dest,f)))}\"",
      "dependencies": [
        "build:vite"
      ],
      "files": [
        "electron/**/*.ts",
        "electron/tsconfig.json",
        "electron/prompts/**/*",
        "shared/**/*.ts",
        "scripts/fix-imports.js"
      ],
      "output": [
        "dist/electron/**/*",
        "dist/shared/**/*"
      ]
    },
    "build": {
      "dependencies": [
        "build:vite",
        "build:electron"
      ]
    },
    "qa": {
      "command": "biome check .",
      "files": [
        "biome.json",
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "shared/**/*.ts"
      ],
      "output": []
    },
    "dist": {
      "command": "electron-builder",
      "dependencies": [
        "build"
      ],
      "files": [
        "dist/**/*",
        "package.json",
        "electron-builder.yml"
      ],
      "output": [
        "release/**/*"
      ]
    },
    "dist:linux": {
      "command": "electron-builder --linux",
      "dependencies": [
        "build"
      ],
      "files": [
        "dist/**/*",
        "package.json",
        "electron-builder.yml"
      ],
      "output": [
        "release/**/*"
      ]
    },
    "dist:mac": {
      "command": "electron-builder --mac",
      "dependencies": [
        "build"
      ],
      "files": [
        "dist/**/*",
        "package.json",
        "electron-builder.yml"
      ],
      "output": [
        "release/**/*"
      ]
    },
    "dist:win": {
      "command": "electron-builder --win",
      "dependencies": [
        "build"
      ],
      "files": [
        "dist/**/*",
        "package.json",
        "electron-builder.yml"
      ],
      "output": [
        "release/**/*"
      ]
    },
    "test": {
      "command": "vitest run",
      "files": [
        "src/**/*.test.{ts,tsx}",
        "electron/**/*.test.ts",
        "vitest.config.ts",
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "shared/**/*.ts"
      ],
      "output": []
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "files": [
        "src/**/*.test.{ts,tsx}",
        "electron/**/*.test.ts",
        "vitest.config.ts",
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "shared/**/*.ts"
      ],
      "output": [
        "dist/coverage/**/*"
      ]
    },
    "test:e2e:headless": {
      "command": "HEADLESS=true xvfb-run -a playwright test",
      "files": [
        "tests/e2e/**/*.ts",
        "playwright.config.ts",
        "dist/**/*"
      ],
      "output": [],
      "dependencies": [
        "build"
      ]
    },
    "validate": {
      "dependencies": [
        "qa",
        "build",
        "test"
      ]
    },
    "dev:vite": {
      "command": "vite",
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vite.config.ts",
        "index.html"
      ],
      "service": true
    },
    "dev:electron": {
      "command": "electron . --ozone-platform=x11 --disable-vulkan",
      "dependencies": [
        "build:electron"
      ],
      "files": [
        "dist/electron/**/*",
        "dist/shared/**/*"
      ],
      "service": true
    },
    "dev": {
      "dependencies": [
        "dev:vite",
        "dev:electron"
      ]
    }
  },
  "build": {
    "appId": "com.openhoat.termaid",
    "productName": "Termaid",
    "icon": "build/icons/icon",
    "publish": {
      "provider": "github",
      "owner": "openhoat",
      "repo": "termaid"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/coverage/**",
      "!dist/test-results/**",
      "!dist/playwright-report/**",
      "!dist/demo/**",
      "package.json",
      "build/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icons"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    }
  }
}
